# Copy this file to .env. Do not commit .env.

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///../data/docuchat.db
CHROMA_PERSIST_DIRECTORY=../data/chroma
UPLOAD_DIRECTORY=../data/uploads

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Local model configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Optional local VISION model for chart/diagram questions. Leave empty for none:
# the text model qwen3:8b cannot read images and is never used as a stand-in, and
# DocuChat never downloads a model for you -- `ollama pull` it yourself first. If
# the name is set but the model isn't installed, the app says so instead of
# pretending. (This was previously defined twice, and the empty second copy
# silently overrode this one.)
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Qwen3 emits a long internal <think> reasoning trace by default; it is
# discarded once the answer is parsed, so skipping it (false) answers ~10x
# faster with no measurable quality loss. Set to true to inspect its
# reasoning instead of optimizing for speed.
OLLAMA_GENERATION_THINK=false
# Keeps the model loaded in Ollama between requests instead of reloading it.
OLLAMA_KEEP_ALIVE=30m
# Context window (tokens) requested for every text generation. Ollama's own
# default is 4096, and a longer prompt is silently cut to ~half the window FROM
# THE FRONT (the instructions and JSON schema are lost, only the tail of the
# passages survives). Measured: the largest prompts DocuChat builds (20-passage
# extraction, 14-passage templates) are ~4-6k tokens. Keep this constant --
# changing it makes Ollama reload the model. Costs ~0.15 MB of memory per token.
OLLAMA_NUM_CTX=8192
# How many chunk-embedding batches to send to Ollama concurrently during
# ingestion. Measured on a 16 GB Apple-silicon Mac (576 chunks, 1/4/8 in flight:
# 76 s / 88 s / 96 s; and no faster against an Ollama with OLLAMA_NUM_PARALLEL=4):
# embedding is compute-bound there, so extra concurrency does not help. It can on
# a machine with GPU headroom -- measure before raising it.
OLLAMA_EMBED_CONCURRENCY=4

# Ingestion and retrieval tuning
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_POOL=40
RETRIEVAL_OVERVIEW_MAX_SOURCES=10

# OCR for scanned PDF pages (runs locally; needs `pip install -r backend/requirements.txt`).
# A page is OCR'd only when it has almost no native text AND images cover most of it.
OCR_ENABLED=true
OCR_MIN_NATIVE_CHARS=30
OCR_MIN_IMAGE_COVERAGE=0.5
OCR_MAX_PAGES=150
