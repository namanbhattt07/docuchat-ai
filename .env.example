# Copy this file to .env. Do not commit .env.

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///../data/docuchat.db
CHROMA_PERSIST_DIRECTORY=../data/chroma
UPLOAD_DIRECTORY=../data/uploads

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Local model configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Qwen3 emits a long internal <think> reasoning trace by default; it is
# discarded once the answer is parsed, so skipping it (false) answers ~10x
# faster with no measurable quality loss. Set to true to inspect its
# reasoning instead of optimizing for speed.
OLLAMA_GENERATION_THINK=false
# Keeps the model loaded in Ollama between requests instead of reloading it.
OLLAMA_KEEP_ALIVE=30m
# How many chunk-embedding batches to send to Ollama concurrently during
# ingestion. Raise if Ollama has GPU/RAM headroom, lower if it falls over.
OLLAMA_EMBED_CONCURRENCY=4

# Ingestion and retrieval tuning
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_POOL=40
RETRIEVAL_OVERVIEW_MAX_SOURCES=10
